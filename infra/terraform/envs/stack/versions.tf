terraform {
  required_version = "= 1.17.2"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "= 6.74.0"
    }

    # N-02 closure: the CloudFront origin-verification value is generated by
    # Terraform, so it is pinned exactly like the AWS provider.
    random = {
      source  = "hashicorp/random"
      version = "= 3.9.1"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # Fail closed: a plan or apply aimed at a different account stops here.
  allowed_account_ids = [var.aws_account_id]

  default_tags {
    tags = local.common_tags
  }
}

# CloudFront viewer certificates must live in us-east-1, while the rest of the
# estate stays in the owner-selected us-east-2.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"

  allowed_account_ids = [var.aws_account_id]

  default_tags {
    tags = local.common_tags
  }
}
