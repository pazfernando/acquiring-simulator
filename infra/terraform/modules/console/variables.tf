variable "name_prefix" {
  description = "Prefix for resource names."
  type        = string
}

variable "aws_account_id" {
  description = "Account id used for WAF log-delivery conditions."
  type        = string
}

variable "console_fqdn" {
  description = "Public console FQDN, for example console.<domain>. Deployment input."
  type        = string

  validation {
    condition     = can(regex("^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", var.console_fqdn))
    error_message = "console_fqdn must be a lowercase FQDN."
  }
}

variable "console_bucket_name" {
  description = "Globally unique private S3 bucket for the SPA. Deployment input."
  type        = string
}

variable "certificate_arn" {
  description = "ACM certificate ARN for the console FQDN in us-east-1 (CloudFront viewer certificate requirement)."
  type        = string
}

variable "http_api_domain_name" {
  description = "Dedicated regional custom-domain FQDN of the console HTTP API (no scheme), used as the /api/* origin. The default execute-api endpoint is disabled, so this domain is the only origin address."
  type        = string

  validation {
    condition     = !strcontains(var.http_api_domain_name, "execute-api")
    error_message = "http_api_domain_name must be the dedicated custom domain, not an execute-api hostname."
  }
}

variable "origin_verify_secret" {
  description = "High-entropy value that CloudFront injects as the origin-verification header on /api/* origin requests (N-02 closure, owner Option B). Generated by the stack root from random_password; never defaulted, never a tfvars or CI value, never logged. The only copy outside encrypted remote state is the CloudFront origin configuration."
  type        = string
  sensitive   = true

  validation {
    condition     = length(var.origin_verify_secret) >= 32 && can(regex("^[A-Za-z0-9._~-]+$", var.origin_verify_secret))
    error_message = "origin_verify_secret must be at least 32 characters of RFC 7230 token-safe ASCII (no whitespace, no control characters)."
  }
}

variable "auth_fqdn" {
  description = "Issuer FQDN (Keycloak), used in CSP and config.json."
  type        = string
}

variable "ws_fqdn" {
  description = "WebSocket FQDN, used in CSP and config.json."
  type        = string
}

variable "issuer_url" {
  description = "Full realm issuer URL, for example https://auth.<domain>/realms/acq-<env>."
  type        = string
}

variable "console_client_id" {
  description = "Public OIDC client id for the SPA (no secret exists)."
  type        = string
  default     = "console-demo"
}

variable "console_audience" {
  description = "Console API audience value."
  type        = string
}

variable "ws_subprotocol" {
  description = "Subprotocol name that carries the WebSocket bearer token."
  type        = string
  default     = "bearer"
}

variable "waf_api_rate_limit" {
  description = "WAF rate limit for /api/* per IP per 5 minutes (proposal; technical abuse bound, not a business quota)."
  type        = number
  default     = 100
}

variable "price_class" {
  description = "CloudFront price class. PriceClass_100 is the cost-minimal technical default; confirm at deployment authorization."
  type        = string
  default     = "PriceClass_100"

  validation {
    condition     = contains(["PriceClass_100", "PriceClass_200", "PriceClass_All"], var.price_class)
    error_message = "price_class must be one of PriceClass_100, PriceClass_200, PriceClass_All."
  }
}

variable "log_retention_days" {
  description = "Retention for the WAF log group."
  type        = number
  default     = 7
}

variable "tags" {
  description = "Common tags."
  type        = map(string)
  default     = {}
}
